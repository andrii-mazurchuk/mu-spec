__pycache__/
*.pyc
.pytest_cache/
*.egg-info/
# Anchored. Unanchored, `build/` matches a directory of that name at ANY
# depth -- it silently swallowed session_types/build/, so a prompt that
# shipped with this unit was never in the repository and nobody could tell.
/build/
/dist/
.venv/

# written into this directory by the gateway at process start -- never
# committed, recomputed on every `holonic start`
peers.json
cost_policy.json
delivery_policy.json

# this unit's own private storage -- projects, entries, the inbox log
state/

# what `walkthrough.py --keep ./demo` leaves behind: a generated project
# tree, rebuilt on every run and never worth committing
demo/

# not a uv project -- pip + pyproject only
uv.lock

# session continuity: what one session tells the next. Local working notes
# about who did what and what to do next, not project state -- they age out
# within days and say nothing about how this unit behaves.
.claude/handoff/
